{
  "uid": "slice-throughput",
  "title": "Throughput",
  "description": "Slice-level throughput dashboard for tap_5g_atnog — uplink, downlink, total per slice and per UE comparison. All values in bps.",
  "tags": [
    "slice-monitoring"
  ],
  "editable": true,
  "schemaVersion": 36,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "UE_IPS",
        "label": "UE IPs",
        "type": "textbox",
        "query": "",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": true
      },
      {
        "name": "rate_window",
        "label": "Rate window",
        "description": "Window of rate() over the byte counters (e.g. 4s, 30s, 1m). Needs at least 2 scrapes: >= 2x the Prometheus scrape interval (1s)",
        "type": "textbox",
        "query": "3s",
        "current": {
          "selected": false,
          "text": "3s",
          "value": "3s"
        },
        "options": [
          {
            "selected": true,
            "text": "3s",
            "value": "3s"
          }
        ],
        "hide": 0
